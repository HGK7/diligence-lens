# Gemini (required for diligence review generation)
GEMINI_API_KEY=your-api-key-here

# Optional: Ollama base URL (Docker Compose often uses host.docker.internal)
# OLLAMA_HOST=http://127.0.0.1:11434

# Qdrant — leave QDRANT_URL unset for local path mode (./data/qdrant).
# Compose sets QDRANT_URL=http://qdrant:6333 (see docs/DOCKER.md).
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_PATH=data/qdrant

# Embedding throughput (Ollama nomic-embed is already on GPU — larger batches
# raise util/throughput). Defaults: 32 / 128. If WinError 10054, lower embed.
# EMBED_BATCH_SIZE=48
# UPSERT_BATCH_SIZE=128

# Review performance (Gemini timeout was the usual stall, not Qdrant search)
# REVIEW_SCORE_THRESHOLD=0.60
# REVIEW_EVIDENCE_LIMIT=6
# EVIDENCE_TEXT_MAX_CHARS=600
# GEMINI_TIMEOUT_SECONDS=240
