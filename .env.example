# Gemini (required for diligence review generation)
GEMINI_API_KEY=your-api-key-here
# Model id for structured review (Interactions API). Default matches PoC knobs.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Ollama base URL
# Local: leave unset or http://127.0.0.1:11434
# Compose sets OLLAMA_HOST=http://host.docker.internal:11434 in docker-compose.yml
# OLLAMA_HOST=http://127.0.0.1:11434

# Qdrant — leave QDRANT_URL unset for local path mode (./data/qdrant).
# Compose sets QDRANT_URL=http://qdrant:6333 (see docs/DOCKER.md).
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_PATH=data/qdrant

# Embedding throughput (Ollama nomic-embed is already on GPU — larger batches
# raise util/throughput). Defaults: 32 / 128. If WinError 10054, lower embed.
# EMBED_BATCH_SIZE=48
# UPSERT_BATCH_SIZE=128

# Review performance (Gemini timeout was the usual stall, not Qdrant search)
# Part 9: review uses MiniLM rerank cut (not dense 0-1). Empty pack → abstain.
# REVIEW_RERANK_THRESHOLD=4.0
# REVIEW_EVIDENCE_LIMIT=8
# Dense-only Evidence Search tab (cosine-style):
# DENSE_SCORE_THRESHOLD=0.60
# EVIDENCE_TEXT_MAX_CHARS=600
# GEMINI_TIMEOUT_SECONDS=240
