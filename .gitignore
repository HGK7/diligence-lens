# --- Datasets (download locally; do not commit corpora) ---
# Keep only the empty placeholder so the folder exists in a fresh clone.
datasets/*
!datasets/.gitkeep

# Belt-and-suspenders for common corpus layouts if placed outside datasets/
**/CUAD_v1/
**/full_contract_txt/
**/full_contract_pdf/
**/contract-nli/
**/sample_dataroom_*/
*.zip

# Active indexed room (regenerate via scripts/export_cuad.py)
dataroom/*
!dataroom/.gitkeep

# Legacy / experiment exports under vendor_docs (keep seed pack if you choose to commit it)
vendor_docs/contract-nli/
vendor_docs/cnli_*/
vendor_docs/cnli_*.md
vendor_docs/cnli_*.txt
vendor_docs/cnli_*.pdf
vendor_docs/_archived_northstar/
vendor_docs/**/raw/

